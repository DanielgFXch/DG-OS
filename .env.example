# Copy to .env for local testing of server/index.js — never commit the
# real .env file (already covered by .gitignore).
#
# TWELVEDATA_API_KEY: required. The same TwelveData API key already used
# as the TWELVEDATA_API_KEY GitHub Actions secret. Get one at
# https://twelvedata.com/ (a free-tier key is enough for this project).
TWELVEDATA_API_KEY=

# PORT: optional, defaults to 8080. Hosting platforms usually set this
# automatically — you normally don't need to set it yourself.
PORT=8080


# Google Workspace Hub (optional, secure server-side OAuth)
# Create a Google Cloud OAuth 2.0 Web application and enable BOTH:
# - Gmail API
# - Google Calendar API
# Then use:
#   <DGOS_PUBLIC_BASE_URL>/api/gmail/oauth/callback
# as an Authorized redirect URI. Never put these values in frontend files.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=

# Public HTTPS origin where server/index.js serves DG OS, e.g.
# https://dgos.example.com
DGOS_PUBLIC_BASE_URL=
DGOS_APP_URL=

# 32-byte encryption key for private Hub refresh tokens.
# Generate locally, for example: openssl rand -hex 32
DGOS_INTEGRATION_ENCRYPTION_KEY=
# Backward-compatible fallback name (optional if generic key is set):
DGOS_GMAIL_ENCRYPTION_KEY=

# Persist this directory on the hosting provider. The default is ./private,
# which is gitignored but may be ephemeral on cloud hosts without a volume.
DGOS_PRIVATE_DATA_DIR=./private
